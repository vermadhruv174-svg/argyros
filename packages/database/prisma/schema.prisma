generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enumerations ─────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  PENDING
  PICKING
  SHIPPED
  DELIVERED
  RETURNED
}

// ─── User & Address ───────────────────────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  role         Role          @default(CUSTOMER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  addresses      Address[]
  orders         Order[]
  cart           Cart?
  wishlist       WishlistItem[]
  refreshTokens  RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String
  country    String
  phone      String?
  createdAt  DateTime @default(now())
}

// ─── Catalogue ────────────────────────────────────────────────────────────────

model Collection {
  id           String              @id @default(cuid())
  slug         String              @unique
  name         String
  description  String?
  type         CollectionType      @default(EVERGREEN)
  imageUrl     String?
  displayOrder Int                 @default(0)
  isFeatured   Boolean             @default(false)
  isPublished  Boolean             @default(false)
  showComingSoon Boolean           @default(false)
  sortOrder    Int                 @default(0)
  kind         String              @default("rule") // "editorial" | "rule"
  expiresAt    DateTime?           // For seasonal collections — auto-archive
  products     ProductCollection[]
  views        CollectionView[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt
}

enum CollectionType {
  SEASONAL
  EVERGREEN
  CURATED
}

model CollectionView {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sessionId    String?    // anonymous visitor
  userId       String?    // logged-in user
  viewedAt     DateTime   @default(now())

  @@index([collectionId])
  @@index([viewedAt])
}

model Product {
  id             String              @id @default(cuid())
  brandId        String              @default("argyros")
  slug           String              @unique
  name           String
  description    String
  metalPurity    String              @default("925 Sterling Silver")
  category       String
  status         ProductStatus       @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  deletedAt      DateTime?

  weightGrams        Decimal?  @db.Decimal(6, 2)
  weightVerified     Boolean   @default(false)
  fulfilment         String    @default("MADE_TO_ORDER")
  dimensions         String?
  chainLengthsInches Int[]
  ringSizes          Int[]
  finish             String?
  audience           String    @default("unisex") // her | him | unisex
  tags               String[]
  imagesJson         Json      @default("[]")
  leadTimeOverrideDays Int?

  images      ProductImage[]
  variants    ProductVariant[]
  collections ProductCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, deletedAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String   @unique
  title          String
  size           String?
  scale          String?  @default("IN")
  weightGrams    Decimal? @db.Decimal(8, 2)
  weightVerified Boolean  @default(false)
  priceCents     Int
  compareAtCents Int?
  stock          Int      @default(0)

  cartItems  CartItem[]
  orderItems OrderItem[]
  wishlist   WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

// ─── Cart ─────────────────────────────────────────────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?    @unique
  items     CartItem[]
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())

  @@index([sessionId])
  @@index([updatedAt])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  email           String
  firstName       String
  lastName        String
  phone           String?
  status          OrderStatus @default(PENDING)
  currency        String      @default("INR")
  subtotalCents   Int
  shippingCents   Int
  taxCents        Int         @default(0)
  totalCents      Int
  shippingAddress Json
  courier         String?
  awb             String?
  trackingUrl     String?

  items        OrderItem[]
  payments     Payment[]
  fulfillments Fulfillment[]
  events       OrderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([number])
  @@index([email])
  @@index([createdAt])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku            String
  name           String
  variantTitle   String?
  size           String?
  metalPurity    String?
  imageUrl       String?
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int

  @@index([orderId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  providerRef String?       @unique
  status      PaymentStatus @default(PENDING)
  amountCents Int
  createdAt   DateTime      @default(now())
}

model Fulfillment {
  id          String            @id @default(cuid())
  orderId     String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      FulfillmentStatus @default(PENDING)
  carrier     String?
  trackingRef String?
  shippedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  payload   Json?
  createdAt DateTime @default(now())
}

// ─── Wishlist ─────────────────────────────────────────────────────────────────

model WishlistItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, variantId])
}

// ─── Bespoke Commissions ──────────────────────────────────────────────────────

enum BespokeStatus {
  RECEIVED
  IN_DISCUSSION
  CAD_ESTIMATE
  IN_MAKING
  COMPLETED
  DECLINED
}

model BespokeInquiry {
  id              String        @id @default(cuid())
  referenceNumber String        @unique
  fullName        String
  email           String
  phone           String
  category        String        // 'Ring', 'Pendant', 'Cuff', 'Earrings', 'Other'
  finish          String        // 'High Polish 925', 'Oxidised Himalayan', '18K Gold Vermeil', 'Satin Matte'
  budgetTier      String?       // '₹3,000 – ₹6,000', '₹6,000 – ₹12,000', '₹12,000+'
  estimatedSize   String?       // 'Size 7', '60mm wrist', etc.
  engraving       String?
  targetDate      String?
  description     String        @db.Text
  imageUrls       String[]      @default([])
  status          BespokeStatus @default(RECEIVED)
  adminNotes      String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([referenceNumber])
  @@index([email])
  @@index([status])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   // "footer" | "home" | "collection:<slug>"
  consentAt DateTime @default(now())
  createdAt DateTime @default(now())
}

