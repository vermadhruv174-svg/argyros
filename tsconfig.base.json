{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": false,
    "baseUrl": ".",
    "paths": {
      "@argyros/brand": ["../aeos-brand/packages/argyros-brand/src/index.ts"],
      "@argyros/config": ["./packages/config/src/index.ts"],
      "@argyros/database": ["./packages/database/src/index.ts"],
      "@argyros/ui": ["./packages/ui/src/index.ts"]
    }
  }
}
