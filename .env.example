# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL 16 connection string
DATABASE_URL="postgresql://user:password@host:5432/argyros?schema=public&sslmode=require"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://default:password@host:6379"

# ─── API ──────────────────────────────────────────────────────────────────────
PORT=4000
WEB_ORIGIN="https://argyros.in"
NODE_ENV=production

# ─── Auth ─────────────────────────────────────────────────────────────────────
# MUST be a cryptographically random 64-char string in production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_STRING

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ─── Web (Next.js — public vars) ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL="https://api.argyros.in/api"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL="https://argyros.in"
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
