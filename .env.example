# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL 16 connection string
DATABASE_URL="postgresql://user:password@host:5432/argyros?schema=public&sslmode=require"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://default:password@host:6379"

# ─── API ──────────────────────────────────────────────────────────────────────
PORT=4000
WEB_ORIGIN="https://argyros-yw1l.vercel.app"
WEB_ORIGINS="https://argyros-yw1l.vercel.app"
NODE_ENV=production
APP_ENV=production

# ─── Auth ─────────────────────────────────────────────────────────────────────
# MUST be a cryptographically random 64-char string in production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_STRING
ORDER_TOKEN_SECRET=CHANGE_THIS_TO_A_SECOND_64_CHAR_RANDOM_STRING
# Required in production. This normalized email, on an ADMIN account, may access Owner Space.
OWNER_EMAIL=owner@example.com
# Set true only after the owner has enrolled TOTP. This makes MFA mandatory for Owner Space.
MFA_ENFORCEMENT=false
# 32-byte AES-256 key, base64 or 64 hex characters. Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=CHANGE_THIS_TO_A_RANDOM_32_BYTE_BASE64_KEY

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ─── Web (Next.js — public vars) ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL="https://api.argyros.in/api"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL="https://argyros-yw1l.vercel.app"
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
